{
  "name": "pigeon",
  "version": "0.1.0",
  "private": true,
  "description": "Pigeon: a reliable, at-least-once webhook delivery service.",
  "main": "dist/api.js",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api.ts",
    "dev:outbox": "ts-node-dev --respawn --transpile-only src/outbox-worker.ts",
    "dev:fanout": "ts-node-dev --respawn --transpile-only src/fanout-worker.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:api",
    "start:api": "node dist/api.js",
    "start:outbox": "node dist/outbox-worker.js",
    "start:fanout": "node dist/fanout-worker.js",
    "start:worker": "node dist/worker.js",
    "demo": "node demo/run.mjs",
    "demo:receiver": "node demo/receiver.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "performance:receiver": "node tests/performance/support/receiver-server.mjs",
    "performance:register-webhook": "node tests/performance/delivery/register-webhook.mjs",
    "performance:fire-events": "node tests/performance/load/fire-events.mjs",
    "performance:ingestion": "node tests/performance/load/measure-ingestion.mjs",
    "performance:ingestion:k6": "k6 run -e \"PIGEON_API_KEY=${PIGEON_API_KEY:?Set PIGEON_API_KEY before running this script.}\" -e \"PIGEON_API_URL=${PIGEON_API_URL:-http://127.0.0.1:3000}\" -e \"PERFORMANCE_VUS=${PERFORMANCE_VUS:-20}\" tests/performance/load/measure-ingestion.k6.js",
    "performance:ingestion:ramp:k6": "k6 run -e \"PIGEON_API_KEY=${PIGEON_API_KEY:?Set PIGEON_API_KEY before running this script.}\" -e \"PIGEON_API_URL=${PIGEON_API_URL:-http://127.0.0.1:3000}\" -e \"PERFORMANCE_RAMP_START_RATE=${PERFORMANCE_RAMP_START_RATE:-100}\" -e \"PERFORMANCE_RAMP_STEP_RATE=${PERFORMANCE_RAMP_STEP_RATE:-100}\" -e \"PERFORMANCE_RAMP_MAX_RATE=${PERFORMANCE_RAMP_MAX_RATE:-600}\" -e \"PERFORMANCE_RAMP_STAGE_DURATION=${PERFORMANCE_RAMP_STAGE_DURATION:-30s}\" tests/performance/load/ramp-ingestion.k6.js",
    "performance:report-delivery-success": "node tests/performance/delivery/report-success.mjs",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "client:create": "ts-node src/scripts/create-client.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.3.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autocannon": "^8.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "nock": "^14.0.17",
    "prettier": "^3.5.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.1.11"
  }
}
