generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ACTIVE
  DISABLED
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  RETRY_SCHEDULED
  DELIVERED
  FAILED_PERMANENT
}

model Client {
  id             String         @id @default(uuid()) @db.Uuid
  apiKeyHash     String         @unique @map("api_key_hash") @db.Char(64)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  subscriptions  Subscription[]
  events         Event[]

  @@map("clients")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  clientId         String             @map("client_id") @db.Uuid
  targetUrl        String             @map("target_url") @db.Text
  eventTypes       String[]           @map("event_types") @db.VarChar(255)
  secret           String             @db.Text
  status           SubscriptionStatus @default(ACTIVE)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@index([clientId, status], map: "subscriptions_client_id_status_idx")
  @@index([status], map: "subscriptions_status_idx")
  @@map("subscriptions")
}

model Event {
  id               String            @id @default(uuid()) @db.Uuid
  clientId         String            @map("client_id") @db.Uuid
  type             String            @db.VarChar(255)
  payload          Json              @db.JsonB
  source           String?           @db.VarChar(255)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@index([clientId, type], map: "events_client_id_type_idx")
  @@index([type], map: "events_type_idx")
  @@map("events")
}

model DeliveryAttempt {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  subscriptionId String         @map("subscription_id") @db.Uuid
  status         DeliveryStatus @default(PENDING)
  httpStatus     Int?           @map("http_status")
  attemptNumber  Int            @default(1) @map("attempt_number")
  nextRetryAt    DateTime?      @map("next_retry_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([eventId, subscriptionId, attemptNumber], map: "delivery_attempts_event_subscription_attempt_key")
  @@index([status, nextRetryAt], map: "delivery_attempts_status_next_retry_at_idx")
  @@index([eventId, createdAt], map: "delivery_attempts_event_id_created_at_idx")
  @@index([subscriptionId, status], map: "delivery_attempts_subscription_id_status_idx")
  @@map("delivery_attempts")
}
