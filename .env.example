# Runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
HEALTH_CHECK_TIMEOUT_MS=2000
METRICS_COLLECTION_TIMEOUT_MS=2000

# Infrastructure defaults for local development, used from Phase 2 onward.
DATABASE_URL=postgresql://postgres@localhost:5432/pigeon?schema=public
REDIS_URL=redis://localhost:6379
DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_BACKOFF_JITTER=0.2
DELIVERY_WORKER_CONCURRENCY=10
DELIVERY_SUBSCRIPTION_CONCURRENCY=1
DELIVERY_THROTTLE_DELAY_MS=1000
DELIVERY_OUTBOX_POLL_INTERVAL_MS=1000
DELIVERY_OUTBOX_BATCH_SIZE=100

# Per-client event ingestion limit.
INGESTION_RATE_LIMIT_WINDOW_MS=60000
INGESTION_RATE_LIMIT_MAX_REQUESTS=100

# Optional host-port overrides used by Docker Compose.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
